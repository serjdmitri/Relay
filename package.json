{
  "name": "relay",
  "productName": "Relay",
  "version": "0.38.2",
  "description": "Voice-first Mac agent. Dictate with Talkify, Relay does the rest.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "shots": "node scripts/screenshots.mjs",
    "icons": "node scripts/make-icons.mjs",
    "pack": "bash scripts/pack-mac.sh",
    "speech": "bash scripts/build-speech.sh",
    "signing": "bash scripts/setup-signing.sh",
    "charts": "node scripts/make-charts.mjs",
    "readme-images": "node scripts/readme-images.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "uiohook-napi": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.49.0"
  },
  "build": {
    "appId": "com.sergey.relay",
    "productName": "Relay",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/build/relay-move",
        "to": "native/relay-move"
      },
      {
        "from": "src/main/tts/omni-worker.py",
        "to": "native/omni-worker.py"
      },
      {
        "from": "extension/firefox",
        "to": "firefox-extension"
      },
      {
        "from": "native/build/relay-speech",
        "to": "native/relay-speech"
      },
      {
        "from": "native/build/relay-glass",
        "to": "native/relay-glass"
      },
      {
        "from": "native/build/relay-ax",
        "to": "native/relay-ax"
      },
      {
        "from": "native/build/relay-embed",
        "to": "native/relay-embed"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Relay controls your apps (Notes, Reminders, Messages, Calendar, Finder, Firefox) when you ask it to.",
        "NSMicrophoneUsageDescription": "Relay listens while you hold or tap its shortcut. Audio is turned into words on this Mac and never leaves it.",
        "NSCameraUsageDescription": "Relay watches your hands through the camera, only while Hand control is on, so you can move holograms in the air. Pictures stay on this Mac and are never saved.",
        "NSSpeechRecognitionUsageDescription": "Relay turns what you say into text using Apple's on-device speech recognition.",
        "NSLocalNetworkUsageDescription": "Relay's network radar looks for phones, tablets and other devices on your own Wi-Fi when you press Scan network. Nothing leaves your network.",
        "NSBonjourServices": [
          "_companion-link._tcp",
          "_airplay._tcp",
          "_apple-mobdev2._tcp",
          "_device-info._tcp",
          "_homekit._tcp",
          "_googlecast._tcp",
          "_raop._tcp"
        ]
      }
    }
  }
}
