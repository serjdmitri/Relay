{
  "name": "relay",
  "productName": "Relay",
  "version": "0.1.0",
  "description": "Voice-first Mac agent. Dictate with Talkify, Relay does the rest.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "shots": "node scripts/screenshots.mjs",
    "icons": "node scripts/make-icons.mjs",
    "pack": "bash scripts/pack-mac.sh"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.0"
  },
  "build": {
    "appId": "com.sergey.relay",
    "productName": "Relay",
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "extraResources": [{ "from": "extension/firefox", "to": "firefox-extension" }],
    "npmRebuild": false,
    "asarUnpack": ["**/node_modules/uiohook-napi/**"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dir", "arch": ["arm64", "x64"] }],
      "icon": "assets/icon.png",
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Relay controls your apps (Notes, Reminders, Messages, Calendar, Finder, Firefox) when you ask it to.",
        "NSMicrophoneUsageDescription": "Not used. Relay relies on Talkify for dictation."
      }
    }
  }
}
